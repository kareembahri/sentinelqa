# Copy this file to .env and fill in the values marked CHANGE_ME.
# .env is listed in .gitignore and must never be committed.
#
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=sentinelqa
POSTGRES_DB=sentinelqa
# Use a generated value (letters, digits, - and _ only).
POSTGRES_PASSWORD=CHANGE_ME

# --- API security ---
# At least 32 characters. Signs login tokens: anyone with it can forge a login.
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_MINUTES=60
# Must be true when served over HTTPS / in production.
COOKIE_SECURE=false

# --- Scan authorization (used from Phase 2B) ---
# Comma-separated host names that may be scanned. Nothing else can be targeted.
ALLOWED_TARGET_HOSTS=juice-shop
# Hosts allowed to resolve to private/loopback IPs and to receive ACTIVE security tests.
ALLOWED_PRIVATE_LAB_HOSTS=juice-shop
